<div class="bg-white p-6 rounded shadow">
  <h1 class="text-2xl font-bold">Ship travel diagnostics</h1>
  <nav aria-label="Travel state filters">
    <% {'All unfinished'=>'','Scheduled'=>'scheduled','Interdicted / paused'=>'interdicted','Awaiting completion'=>'awaiting_completion','Needs review'=>'needs_review'}.each do |label, value| %>
      <%= link_to label, admin_ship_travels_path(state:value), class:'underline mr-4' %>
    <% end %>
  </nav>
  <p>Read-only diagnostics. Showing at most 100 journeys per page. Review warnings may overlap a paused state.</p>
  <% @ship_travels.each do |travel| %>
    <article class="border rounded p-4 mt-4">
      <%= render 'admin/ship_travels/state', travel:travel, state:@states.fetch(travel.id) %>
      <%= link_to 'View journey', admin_ship_travel_path(travel), class:'underline' %>
    </article>
  <% end %>
  <% if @ship_travels.empty? %><p>No matching journeys on this page.</p><% end %>
  <% if @next_id %><%= link_to 'Next page', admin_ship_travels_path(state:@filter,after:@next_id) %><% end %>
</div>
