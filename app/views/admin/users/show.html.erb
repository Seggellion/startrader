<%#
  Admin user overview (discovery F-09 / F-21). Light-modern tokens from
  admin/user_ships/edit. All data comes from Admin::UserOverview (@overview);
  do not add per-record queries here.
%>
<%
  o = @overview
  panel_class = "rounded-lg border border-slate-200 bg-white shadow-sm"
  label_class = "text-xs font-semibold text-slate-500"
  value_class = "mt-1 text-sm font-medium text-slate-900"
  muted_value_class = "mt-1 text-sm text-slate-400"
  button_class = "inline-flex items-center rounded-md border border-cyan-500 px-3 py-2 text-sm font-semibold text-cyan-700 transition hover:bg-cyan-50"
  chip_class = "rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm"
  render_field = lambda do |label, value, missing: "Not recorded", mono: false|
    content_tag(:div) do
      safe_join([
        content_tag(:p, label, class: label_class),
        content_tag(:p, value.nil? || value == "" ? missing : value,
          class: [(value.nil? || value == "") ? muted_value_class : value_class, (mono ? "font-mono break-all" : nil)].compact.join(" "))
      ])
    end
  end
  role = @user.admin? ? "Administrator" : "Player"
%>

<div class="mx-auto max-w-7xl space-y-6" data-admin-user-overview="<%= @user.id %>">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="flex items-center gap-4">
      <span class="flex h-16 w-16 items-center justify-center rounded-full border border-slate-200 bg-slate-100 text-xl font-bold text-slate-600" aria-hidden="true"><%= admin_initials(@user) %></span>
      <div>
        <%= link_to "Back to Users", admin_users_path, class: "text-sm font-semibold text-cyan-700 hover:text-cyan-900" %>
        <h1 class="mt-1 text-3xl font-bold text-slate-950"><%= @user.username.presence || "User ##{@user.id}" %></h1>
        <p class="mt-1 text-sm text-slate-500">User #<%= @user.id %> · <%= role %> · times shown in UTC</p>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Edit User", edit_admin_user_path(@user), class: button_class %>
      <%= link_to "All Shard Memberships", admin_shard_users_path, class: button_class %>
    </div>
  </div>

  <section aria-label="Status summary" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
    <% [["Simulation tick", o.tick, nil],
        ["Shard memberships", o.memberships.size, nil],
        ["Ships", o.ship_count, nil],
        ["In transit", o.in_transit_count, nil],
        ["Interdicted", o.interdicted_count, (o.interdicted_count.positive? ? "text-amber-700" : nil)],
        ["Location mismatches", o.divergence_count, (o.divergence_count.positive? ? "text-rose-700" : "text-emerald-700")]].each do |label, value, tone| %>
      <div class="<%= chip_class %>" data-summary="<%= label.parameterize %>">
        <p class="<%= label_class %>"><%= label %></p>
        <p class="mt-1 text-2xl font-bold <%= tone || 'text-slate-900' %>"><%= value %></p>
      </div>
    <% end %>
  </section>

  <div class="grid gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
      <section class="<%= panel_class %>" aria-labelledby="identity-heading">
        <div class="border-b border-slate-200 p-5">
          <h2 id="identity-heading" class="text-lg font-semibold text-slate-950">Identity</h2>
        </div>
        <div class="grid gap-4 p-5 sm:grid-cols-2 lg:grid-cols-3">
          <%= render_field.call("User ID", @user.id) %>
          <%= render_field.call("Username", @user.username.presence) %>
          <%= render_field.call("Role", role) %>
          <%= render_field.call("Twitch ID", @user.twitch_id.presence, mono: true) %>
          <%= render_field.call("UID", @user.uid.presence, mono: true) %>
          <%= render_field.call("Provider", @user.provider.presence) %>
          <%= render_field.call("Account created", admin_utc(@user.created_at)) %>
          <%= render_field.call("Record updated", admin_utc(@user.updated_at)) %>
          <%= render_field.call("Last sign-in (OAuth only, not gameplay)", admin_utc(@user.last_login, missing: "Never")) %>
          <%= render_field.call("Last record write (approximate)", admin_utc(o.last_record_write_at)) %>
          <%= render_field.call("Linked shards", o.memberships.map { |m| m.shard&.name || m.shard_user.shard_name }.compact.join(", ").presence, missing: "No shard memberships") %>
          <%= render_field.call("Platform wallet (legacy field, not gameplay credits)", admin_credits(@user.wallet_balance)) %>
        </div>
      </section>

      <% if o.memberships.empty? %>
        <section class="<%= panel_class %> p-5">
          <h2 class="text-lg font-semibold text-slate-950">Shard memberships</h2>
          <p class="mt-2 text-sm text-slate-500">No shard memberships. This user has never synchronized with a shard.</p>
        </section>
      <% end %>

      <% o.memberships.each do |membership| %>
        <%= render "admin/users/membership", membership: membership, o: o, panel_class: panel_class,
              label_class: label_class, render_field: render_field %>
      <% end %>

      <% if o.unlinked_ships.any? %>
        <section class="<%= panel_class %>" data-unlinked-ships>
          <div class="border-b border-slate-200 p-5">
            <h2 class="text-lg font-semibold text-slate-950">Ships not linked to this user's memberships</h2>
            <p class="mt-1 text-sm text-rose-700">Needs review: these ships have no shard membership, or point at another player's membership.</p>
          </div>
          <div class="divide-y divide-slate-200">
            <% o.unlinked_ships.each do |row| %>
              <%= render "admin/users/ship", row: row, o: o, render_field: render_field, label_class: label_class %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <aside class="space-y-6" aria-label="Diagnostics">
      <section class="<%= panel_class %> p-5">
        <h2 class="text-lg font-semibold text-slate-950">Synchronization summary</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Mismatched ship/player pairs</dt><dd class="font-semibold"><%= o.divergence_count %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Memberships with unknown location</dt><dd class="font-semibold"><%= o.unknown_player_location_count %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Case-variant shard UUID groups</dt><dd class="font-semibold"><%= o.shard_uuid_variant_groups %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Twitch ID equals UID</dt><dd class="font-semibold"><%= o.identity[:twitch_id_matches_uid] ? "Yes" : "No" %></dd></div>
        </dl>
      </section>

      <details class="<%= panel_class %> p-5" data-diagnostics>
        <summary class="cursor-pointer text-lg font-semibold text-slate-950">Tick chain</summary>
        <% tc = o.tick_control %>
        <% if tc %>
          <dl class="mt-4 space-y-2 text-sm">
            <% {"Running" => (tc.running? ? "Yes" : "No"),
                "Seconds per tick" => o.seconds_per_tick,
                "Last tick started" => admin_utc(tc.last_tick_started_at),
                "Last tick completed" => admin_utc(tc.last_tick_completed_at),
                "Last tick failed" => admin_utc(tc.last_tick_failed_at, missing: "Never"),
                "Last error class" => (tc.last_tick_error_class.presence || "None"),
                "Last heartbeat" => admin_utc(tc.last_heartbeat_at),
                "Failure count" => tc.failure_count,
                "Last recovered" => admin_utc(tc.last_recovered_at, missing: "Never"),
                "Heartbeat stale?" => (tc.stale? ? "Yes" : "No")}.each do |label, value| %>
              <div class="flex justify-between gap-3"><dt class="text-slate-500"><%= label %></dt><dd class="text-right font-medium"><%= value %></dd></div>
            <% end %>
          </dl>
        <% else %>
          <p class="mt-3 text-sm text-slate-500">No tick control record.</p>
        <% end %>
      </details>

      <details class="<%= panel_class %> p-5">
        <summary class="cursor-pointer text-lg font-semibold text-slate-950">Not yet instrumented</summary>
        <p class="mt-3 text-sm text-slate-500">The schema does not yet record these, so this page does not show them: last successful status synchronization, when the player location last changed, and which authority (client status, departure, arrival, repair) changed it.</p>
      </details>
    </aside>
  </div>
</div>
