<nav aria-label="<%= label %> pagination" class="flex flex-wrap items-center justify-between gap-3 border-t border-zinc-800 p-4 text-sm">
  <% if group.previous_page %>
    <%= link_to "Previous", star_trader_market_path(result.filters.merge(page_key => group.previous_page)), rel: "prev", aria: {label: "Previous #{label} page"}, class: "rounded border border-zinc-700 px-3 py-2", data: {turbo_frame: "_top"} %>
  <% else %><span class="px-3 py-2 text-zinc-600">Previous</span><% end %>
  <span class="text-xs text-zinc-400">Page <%= group.page %><%= group.total_pages.positive? ? " / #{group.total_pages}" : "" %></span>
  <% if group.next_page %>
    <%= link_to "Next", star_trader_market_path(result.filters.merge(page_key => group.next_page)), rel: "next", aria: {label: "Next #{label} page"}, class: "rounded border border-zinc-700 px-3 py-2", data: {turbo_frame: "_top"} %>
  <% else %><span class="px-3 py-2 text-zinc-600">Next</span><% end %>
</nav>
