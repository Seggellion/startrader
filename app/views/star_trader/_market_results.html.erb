<% result = local_assigns.fetch(:market_result, @market_result) %>
<% selected_state = { filters: result.filters, terminal_name: result.terminal&.name, terminal_system: result.terminal&.location&.star_system_name, terminal_context: result.terminal ? terminal_selection_context(result.terminal) : "" } %>
<%= turbo_frame_tag "market_results", data: { controller: "market-results", market_results_grouped_value: result.grouped?, market_results_applied_value: selected_state.to_json, market_results_url_value: star_trader_market_path(result.filters), action: "turbo:before-stream-render@document->market-results#stream turbo:before-visit@document->market-results#navigating turbo:before-fetch-request->market-results#navigating focusout@document->market-results#schedule turbo:frame-load->market-results#loaded" } do %>
  <div hidden data-market-results-target="snapshot" data-state="<%= selected_state.to_json %>" data-url="<%= star_trader_market_path(result.filters) %>"></div>
  <section class="overflow-hidden rounded-lg border border-zinc-800 bg-zinc-900/90">
    <div class="space-y-2 border-b border-zinc-800 p-4">
      <h2 id="market_results_heading" tabindex="-1" class="text-lg font-semibold text-white"><%= result.grouped? ? "Terminal Market" : "Market Browser" %></h2>
      <% if result.selection_error %><p role="alert" class="text-sm text-amber-200"><%= result.selection_error %></p><% end %>
      <% if result.warning %><p role="alert" class="text-sm text-amber-200"><%= result.warning %></p><% end %>
      <% if result.grouped? %>
        <% if result.terminal %>
          <h3 class="break-words font-semibold text-cyan-100"><%= result.terminal.name %></h3>
          <p class="break-words text-xs text-zinc-400"><%= terminal_selection_context(result.terminal) %></p>
        <% end %>
        <p class="text-xs text-zinc-400">Snapshot <time datetime="<%= result.generated_at.iso8601 %>"><%= result.generated_at.utc.strftime("%Y-%m-%d %H:%M:%S UTC") %></time>. Support does not guarantee a trade can execute.</p>
        <p class="text-xs text-zinc-400">Upstream market data last modified: <%= result.source_modified_at ? Time.at(result.source_modified_at).utc.strftime("%Y-%m-%d %H:%M UTC") : "Unknown" %>. Simulated prices and inventory can change separately.</p>
        <div class="flex flex-wrap items-center gap-3 text-xs">
          <%= link_to "Refresh results", star_trader_market_path(result.filters), id: "market_refresh", class: "rounded border border-zinc-700 px-3 py-2", data: { action: "market-results#refresh" } %>
          <%= link_to "Clear terminal and apply", star_trader_market_path(result.filters.except(:terminal_api_id, :buy_page, :sell_page)), data: { turbo_frame: "_top" }, class: "rounded border border-zinc-700 px-3 py-2" %>
          <% if result.warning %>
            <%= link_to "Clear system and apply", star_trader_market_path(result.filters.except(:star_system, :buy_page, :sell_page)), data: { turbo_frame: "_top" }, class: "rounded border border-zinc-700 px-3 py-2" %>
          <% end %>
        </div>
        <p hidden role="status" aria-live="polite" class="text-xs text-cyan-200" data-market-results-target="status">Updates available.</p>
      <% end %>
    </div>
    <% if result.grouped? %>
      <%= render "market_group", group: result.buy, side: "buy", result: result %>
      <%= render "market_group", group: result.sell, side: "sell", result: result %>
    <% else %>
      <p class="px-4 py-3 text-sm text-zinc-400"><%= market_quantity(result.legacy.total_count) %> matching market rows, showing <%= result.legacy.rows.size %> on page <%= result.legacy.page %><%= result.legacy.total_pages.positive? ? " of #{result.legacy.total_pages}" : "" %>.</p>
      <div class="hidden grid-cols-[1.25fr_1fr_0.9fr_0.9fr_0.8fr_0.8fr_0.8fr_110px] gap-3 border-b border-zinc-800 bg-zinc-950/80 px-4 py-3 text-xs font-semibold uppercase text-zinc-400 lg:grid">
        <span>Location</span><span>Commodity</span><span class="text-right">Player buy price</span><span class="text-right">Player sell price</span><span class="text-right">Inventory</span><span class="text-right">Buy-side SCU</span><span class="text-right">Player spread</span><span class="text-right">Action</span>
      </div>
      <div class="divide-y divide-zinc-800">
        <% if result.legacy.rows.any? %>
          <%= render partial: "star_trader/market_row", collection: result.legacy.rows, as: :facility %>
        <% else %><p class="p-8 text-center text-zinc-400">No facilities match the current filters.</p><% end %>
      </div>
      <%= render "market_pagination", group: result.legacy, page_key: :page, result: result, label: "Market" %>
    <% end %>
  </section>
<% end %>
